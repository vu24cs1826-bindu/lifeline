PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/lifeline
JWT_SECRET=replace_with_a_long_random_string_at_least_32_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# First admin account (created by: npm run seed:admin)
ADMIN_NAME=LifeLine Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisStrongPassword1

# AI classification (optional). Without a key, the built-in fallback classifier is used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Matching and escalation
DEFAULT_RADIUS_KM=10
ESCALATION_MINUTES=2
ESCALATION_MAX_RADIUS_KM=100
